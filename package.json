{
  "name": "triage-coins",
  "version": "1.0.0",
  "description": "Real-time BTC cross-exchange arbitrage detection & simulation bot (Kraken, Bybit, OKX)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "tsx src/index.ts",
    "build": "npm --prefix web install && npm --prefix web run build",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3"
  }
}
